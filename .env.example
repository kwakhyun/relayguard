# Generate a random admin token:
# docker run --rm ghcr.io/kwakhyun/relayguard:0.1.1 relayguard generate-admin-token
# Docker Compose reads .env automatically: copy this file to .env and fill in the tokens.
# The Python CLI does NOT load .env; export variables or inject them from a secret manager.
RELAYGUARD_ADMIN_TOKEN=
RELAYGUARD_UPSTREAM_URL=https://api.example.com
RELAYGUARD_UPSTREAM_TOKEN=
# compose.yaml sets /data/relayguard.db inside the container.
# For the Python CLI, choose a writable path and export RELAYGUARD_DB explicitly.
# RELAYGUARD_DB=.relayguard/relayguard.db
