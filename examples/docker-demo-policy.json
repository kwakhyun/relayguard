{
  "name": "Synthetic Docker demo only",
  "ttl_hours": 24,
  "policy": {
    "routes": [
      {
        "method": "GET",
        "path": "/customers",
        "query_keys": [
          "limit"
        ]
      }
    ],
    "ip_allowlist": [],
    "requests_per_minute": 30,
    "response_bytes_limit": 16384,
    "bytes_per_minute": 65536,
    "max_total_requests": 100,
    "max_total_bytes": 1048576
  }
}
