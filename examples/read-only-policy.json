{
  "name": "CRM read-only integration",
  "ttl_hours": 24,
  "policy": {
    "routes": [{"method": "GET", "path": "/customers", "query_keys": ["limit"]}],
    "ip_allowlist": ["127.0.0.1/32", "::1/128"],
    "requests_per_minute": 30,
    "response_bytes_limit": 16384,
    "bytes_per_minute": 65536
  }
}
